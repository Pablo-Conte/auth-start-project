{
    "name": "template",
    "version": "0.0.1",
    "main": "dist/src/shared/main/index.js",
    "type": "module",
    "license": "MIT",
    "scripts": {
        "postinstall": "npx prisma generate --config ./src/shared/infra/database/prisma/prisma.config.ts",
        "clean": "rimraf dist",
        "build": "npm run clean && tsc -p tsconfig.json",
        "esbuild": "npm run clean && node --no-warnings ./esbuild.config.js",
        "start": "node --env-file .env dist/src/shared/main/index.js",
        "local": "npx nodemon --inspect",
        "prepare": "husky install",
        "lint": "npx eslint ./src --ext .js,.jsx,.ts,.tsx --max-warnings=0",
        "lint:fix": "npx eslint --fix \"src/**/*.ts\"",
        "format": "prettier --write \"src/**/*.ts\"",
        "prettier": "prettier --write .",
        "test": "vitest",
        "coverage": "vitest run --coverage",
        "prisma:generate": "npx prisma generate --config ./src/shared/infra/database/prisma/prisma.config.ts",
        "migrate:new": "dotenv -e .env -- npx prisma migrate dev --create-only --config ./src/shared/infra/database/prisma/prisma.config.ts",
        "migrate:run": "dotenv -e .env -- npx prisma migrate deploy --config ./src/shared/infra/database/prisma/prisma.config.ts",
        "migrate:reset": "dotenv -e .env -- npx prisma migrate reset --config ./src/shared/infra/database/prisma/prisma.config.ts",
        "migrate:run:prod": "dotenv -e .env.prod -- npx prisma migrate deploy --config ./src/shared/infra/database/prisma/prisma.config.ts",
        "seed:all": "dotenv -e .env -- sh ./src/shared/infra/database/seeds/index.sh",
        "seed:all:prod": "dotenv -e .env.prod -- sh ./src/shared/infra/database/seeds/index.sh",
        "reset:database": "npm run migrate:reset && npm run seed:all",
        "reset:database:prod": "dotenv -e .env.prod npm run migrate:reset && npm run seed:all:prod"
    },
    "engines": {
        "node": "22.22.1"
    },
    "overrides": {
        "json5": ">=2.2.2",
        "semver": ">=7.5.2",
        "undici": ">=5.26.1"
    },
    "resolutions": {
        "json5": ">=2.2.2",
        "semver": ">=7.5.2",
        "undici": ">=5.26.1"
    },
    "lint-staged": {
        "**/*.{js,jsx,ts,tsx}": [
            "npx eslint --fix --max-warnings=0"
        ]
    },
    "devDependencies": {
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.25",
        "@types/express-list-endpoints": "^7.1.0",
        "@types/html-minifier": "^4.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/mime-types": "^3.0.1",
        "@types/module-alias": "^2.0.4",
        "@types/node": "^25.5.0",
        "@types/nodemailer": "^7.0.11",
        "@types/pdfkit": "^0.17.5",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/uuid": "^11.0.0",
        "@types/validatorjs": "^3.15.5",
        "@typescript-eslint/eslint-plugin": "^8.57.1",
        "@typescript-eslint/parser": "^8.57.1",
        "@vitest/coverage-istanbul": "^4.1.0",
        "dotenv": "^17.4.0",
        "dotenv-cli": "^11.0.0",
        "esbuild": "^0.27.4",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-import-helpers": "^2.0.1",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-vitest-globals": "^1.6.1",
        "husky": "^9.1.7",
        "nodemon": "^3.1.14",
        "prettier": "^3.8.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^4.1.0"
    },
    "dependencies": {
        "@asteasolutions/zod-to-openapi": "^8.5.0",
        "@aws-sdk/client-cognito-identity-provider": "^3.1014.0",
        "@aws-sdk/client-eventbridge": "^3.1014.0",
        "@aws-sdk/client-iam": "^3.1014.0",
        "@aws-sdk/client-lambda": "^3.1014.0",
        "@aws-sdk/client-s3": "^3.1014.0",
        "@aws-sdk/client-ses": "^3.1014.0",
        "@aws-sdk/s3-request-presigner": "^3.1014.0",
        "@aws-sdk/types": "^3.973.6",
        "@prisma/adapter-pg": "^7.5.0",
        "@prisma/client": "^7.5.0",
        "@types/html-minifier-terser": "^7.0.2",
        "@types/mime": "^4.0.0",
        "@types/multer": "^2.1.0",
        "@types/pdfkit": "^0.17.5",
        "aws-jwt-verify": "^5.1.1",
        "bcrypt": "^6.0.0",
        "compression": "^1.8.1",
        "cors": "^2.8.6",
        "cpf-cnpj-validator": "^1.0.3",
        "dayjs": "^1.11.20",
        "encodeurl": "^2.0.0",
        "express": "^4.22.1",
        "express-async-errors": "^3.1.1",
        "express-list-endpoints": "^7.1.1",
        "firebase-admin": "^10.3.0",
        "generate-password": "^1.7.1",
        "handlebars": "^4.7.8",
        "html-minifier-terser": "^7.2.0",
        "jsonwebtoken": "^9.0.3",
        "jszip": "^3.10.1",
        "mime": "^4.1.0",
        "mime-types": "^3.0.2",
        "module-alias": "^2.3.4",
        "multer": "^2.1.1",
        "nodemailer": "^8.0.3",
        "pdfkit": "^0.18.0",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "prisma": "^7.5.0",
        "prisma-dbml-generator": "^0.6.0",
        "prisma-docs-generator": "^0.4.0",
        "reflect-metadata": "^0.2.2",
        "swagger-ui-express": "^5.0.1",
        "tsyringe": "^4.10.0",
        "uuid": "^13.0.0",
        "validatorjs": "^3.22.1",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz",
        "zod": "^4.3.6"
    }
}
